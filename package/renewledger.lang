[zh-cn]
name = "个人订阅台账"
auth = "316z666"
descript = "登记订阅费用、查询续费日，按月或年推进账期。"
important = "首次启动后，在应用 data/password.txt 查看 admin 的随机密码；仅在受信任的局域网或 HTTPS 代理后访问。"
release_note = "首版，支持人民币月付和年付订阅。"

